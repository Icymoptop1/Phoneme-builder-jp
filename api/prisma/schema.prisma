generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Word {
  id        Int            @id @default(autoincrement())
  english   String
  phonemes  String
  hint      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  wordLists WordListWord[]
}

model WordList {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  words       WordListWord[]
  Activities  Activity[]
}

model WordListWord {
  id         Int      @id @default(autoincrement())

  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  wordId     Int

  wordList   WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  wordListId Int

  @@unique([wordId, wordListId])
}

enum ActivityType {
  WORDLE
  WORD_SEARCH
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Activity {
  id           Int          @id @default(autoincrement())
  name         String
  type         ActivityType
  difficulty   Difficulty
  maxAttempts  Int?
  gridSize     Int?
  hintsEnabled Boolean      @default(true)
  theme        String       @default("light")
  settings     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  wordList     WordList     @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  wordListId   Int
}