generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Word {
  id        Int      @id @default(autoincrement())
  english   String
  phonemes  String
  hint      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}